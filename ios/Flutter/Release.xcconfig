#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
// Google Sign-In ids for Info.plist (GIDClientID + the URL scheme).
// The placeholders keep the build valid when Google is not configured;
// real values come from the gitignored config/google.xcconfig.
GOOGLE_IOS_CLIENT_ID = unconfigured
GOOGLE_REVERSED_CLIENT_ID = be.alexhendrickx.timer.google-unconfigured
#include? "../../config/google.xcconfig"
